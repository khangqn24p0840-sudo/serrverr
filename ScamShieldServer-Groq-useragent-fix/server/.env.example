# ScamShield Server - Groq la nha cung cap AI chinh.
# Tao API key trong Groq Console > API Keys. Khong commit file .env that len GitHub.
AI_PROVIDER=groq
GROQ_API_KEY=
# Model van ban san xuat, nhe va tiet kiem hon:
GROQ_MODEL=openai/gpt-oss-20b
# Model co kha nang nhan anh theo tai lieu Groq (preview):
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_SECONDS=120

# Tuy chon: chi dung neu ban chu dong doi AI_PROVIDER sang gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=

# Tuy chon: chi dung neu ban chu dong doi AI_PROVIDER sang openrouter.
OPENROUTER_API_KEY=

# Khoa quan tri trang /admin. Bat buoc thay chuoi mau.
ADMIN_KEY=
VIETQR_CLIENT_ID=
VIETQR_API_KEY=
ALLOW_REGISTRATION=true
SECRET_KEY=
NEWS_ENABLED=true
NEWS_INTERVAL_MIN=30
NEWS_KEEP_DAYS=60
ADMIN_LOCAL_ONLY=true
TRUST_PROXY=true
